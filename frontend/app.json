{
  "expo": {
    "name": "Mqulima",
    "slug": "mqulima",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mqulima",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Mqulima to take crop and farm photos for AI disease diagnosis and community posts.",
        "NSPhotoLibraryUsageDescription": "Allow Mqulima to choose farm photos for AI disease diagnosis and community posts.",
        "NSLocationWhenInUseUsageDescription": "Allow Mqulima to access your farm location for accurate county weather forecasts and input delivery."
      },
      "bundleIdentifier": "com.mqulima.app"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a5438"
      },
      "package": "com.mqulima.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFBF9"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mqulima to choose farm photos for AI crop diagnosis and community posts.",
          "cameraPermission": "Allow Mqulima to capture crop photos for AI pest & disease diagnosis.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Mqulima to detect your county for localized weather forecasts and input delivery."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      "@react-native-vector-icons/fontawesome6",
      "@sentry/react-native",
      "./plugins/withOptionalHardwareFeatures"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "594b0049-94e5-413c-9abc-42d12ea18b54"
      }
    },
    "owner": "rf-admins-team"
  }
}
