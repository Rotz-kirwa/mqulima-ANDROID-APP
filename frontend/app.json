{
  "expo": {
    "name": "Mqulima",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": { "NSPhotoLibraryUsageDescription": "Choose images for products and articles" },
      "bundleIdentifier": "com.emergent.agriecosystem.dg1zxg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a5438"
      },
      "package": "com.emergent.agriecosystem.dg1zxg"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFBF9"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Choose images for products and articles", "cameraPermission": false, "microphonePermission": false }],
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      "@react-native-vector-icons/fontawesome6"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}